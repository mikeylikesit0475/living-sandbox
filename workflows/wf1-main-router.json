      "typeVersion": 1,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const state = $input.first().json;\nconst next = JSON.parse(JSON.stringify(state));\nnext.loop.remaining = (next.loop.remaining || 1) - 1;\nif (next.loop.remaining < 0) next.loop.remaining = 0;\nreturn [{ json: next }];\n"
      },
      "id": "wf1-rework",
      "name": "Prepare rework \u2192 Lab",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const state = $input.first().json;\nreturn [{ json: { task_id: state.task_id, workflow: \"wf1-main-router\", gate: \"audit-exhausted\", verdict: `failed after ${3 - (state.loop.remaining||0)} reworks`, duration_ms: 0, state } }];\n"
      },
      "id": "wf1-failed",
      "name": "Log failure \u2192 swarm_log",
