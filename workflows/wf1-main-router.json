    {
      "parameters": {
        "jsCode": "// WF-1 init \u2014 state per 02 \u00a73\nconst body = $input.first().json.body || $input.first().json;\nconst goal = body.goal || body.input || $input.first().json.goal || \"reverse this string: hello\";\nconst task_id = `task-${Date.now()}-${Math.random().toString(36).slice(2,8)}`;\nconst state = {\n  schema_version: 1,\n  task_id: task_id,\n  goal: String(goal),\n  loop: { gate: \"audit\", remaining: 3 },\n  recall: { reusable_tools: [], mutation_constraints: [] },\n  candidate: null,\n  test: { passed: false, runs: [] },\n  audit: { security_pass: true, edge_case_pass: true, objections: [] },\n  outcome: { status: \"\", final_answer: \"\" }\n};\nlet toolInput = String(goal);\nconst m = /:\\s*\"?([^\"\\n]+)\"?\\s*$/.exec(toolInput);\nif (m) toolInput = m[1].trim();\nstate.test.runs = [];\nreturn [{ json: { ...state, _toolInput: toolInput } }];\n"
      },
      "id": "wf1-init",
      "name": "Init state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "2WAKnAYqDQx9goe7"
        }
      },
      "id": "wf1-call-recall",
      "name": "Call Recall (WF-7)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.recall.reusable_tools.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "wf1-switch-reuse",
      "name": "Switch: reusable_tool?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF-1 reuse path \u2014 take top reusable tool as candidate, skip Lab\nconst state = $input.first().json;\nconst top = state.recall.reusable_tools[0];\nconst next = JSON.parse(JSON.stringify(state));\nnext.candidate = {\n  tool_name: top.tool_name,\n  code: top.code,\n  description: top.description,\n  input_schema: top.input_schema,\n  language: 'python'\n};\nnext.outcome = next.outcome || {};\nnext.outcome.status = 'reused';\n// Add mutation constraints already in recall for observability\nreturn [{ json: next }];\n"
      },
      "id": "wf1-reuse-pick",
      "name": "Pick reusable tool",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
