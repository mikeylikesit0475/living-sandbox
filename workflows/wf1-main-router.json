        900,
        300
      ],
      "disabled": false
    },
    {
      "parameters": {
        "jsCode": "// WF-1 reuse path — take top reusable tool as candidate, skip Lab\nconst state = $input.first().json;\nconst top = state.recall?.reusable_tools?.[0];\nif (!top || !top.tool_name || !top.code) {\n  const next = JSON.parse(JSON.stringify(state));\n  next._hasReusable = false;\n  next.candidate = null;\n  next.outcome = next.outcome || {};\n  next.outcome.status = \"no_reuse_fallback\";\n  return [{ json: next }];\n}\nconst next = JSON.parse(JSON.stringify(state));\nnext.candidate = {\n  tool_name: top.tool_name,\n  code: top.code,\n  description: top.description,\n  input_schema: top.input_schema,\n  language: \"python\"\n};\nnext.outcome = next.outcome || {};\nnext.outcome.status = \"reused\";\nreturn [{ json: next }];"
      },
