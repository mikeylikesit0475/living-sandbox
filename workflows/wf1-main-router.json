    {
      "parameters": {
        "jsCode": "// WF-1 init — state per 02 §3\nconst body = $input.first().json.body || $input.first().json;\nconst goal = body.goal || body.input || $input.first().json.goal || \"reverse this string: hello\";\nconst task_id = `task-${Date.now()}-${Math.random().toString(36).slice(2,8)}`;\nconst state = {\n  schema_version: 1,\n  task_id: task_id,\n  goal: String(goal),\n  loop: { gate: \"audit\", remaining: 3 },\n  recall: { reusable_tools: [], mutation_constraints: [] },\n  candidate: null,\n  test: { passed: false, runs: [] },\n  audit: { security_pass: true, edge_case_pass: true, objections: [] },\n  outcome: { status: \"\", final_answer: \"\" }\n};\nlet toolInput = String(goal);\nconst m = /:\\s*\"?([^\"\\n]+)\"?\\s*$/.exec(toolInput);\nif (m) toolInput = m[1].trim();\nstate.test.runs = [];\nreturn [{ json: { ...state, _toolInput: toolInput } }];\n"
      },
      "id": "wf1-init",
      "name": "Init state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "disabled": false
    },
    {
      "parameters": {
