      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const state = $input.first().json;\nconst rt = state.recall?.reusable_tools;\nstate._hasReusable = Array.isArray(rt) && rt.length > 0 && !!rt[0]?.tool_name && !!rt[0]?.code;\nreturn [{json: state}];",
        "notice": ""
      },
      "disabled": false
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json._hasReusable }}",
              "operation": "equal",
              "value2": true
            }
          ]
        },
        "options": {}
      },
      "id": "wf1-switch-reuse",
      "name": "Switch: reusable_tool?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
