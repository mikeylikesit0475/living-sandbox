        "jsCode": "const state = $input.first().json;\nconst sec = state.audit?.security_pass;\nconst edge = state.audit?.edge_case_pass;\nconst remaining = state.loop?.remaining ?? 0;\nlet decision;\nif (sec && edge) decision = \"deploy\";\nelse if (remaining > 0) decision = \"rework\";\nelse decision = \"failed\";\nreturn [{ json: { ...state, _auditDecision: decision } }];\n"
      },
      "id": "wf1-decide",
      "name": "Decide: deploy/rework/failed",
